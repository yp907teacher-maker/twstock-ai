# 複製為 backend/.env 後填入。金鑰只放這裡，不要提交到版本控制。

# 示範模式：true 時使用合成資料（獨立的 data/twstock_demo.db），畫面全程標示「示範資料」
DEMO_MODE=false

# FinMind（免費註冊 https://finmindtrade.com/ → 個人資訊取得 token）；帶 token 600 次/小時
FINMIND_TOKEN=
FINMIND_HOURLY_LIMIT=550
BACKFILL_START=2015-01-01

# Fugle MarketData（免費註冊 https://developer.fugle.tw/ 取得 API key）；盤中刷新用，可留空
FUGLE_API_KEY=

# Claude API（https://console.anthropic.com/）；留空則 AI 報告改用程式化量化摘要
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MONTHLY_CALL_LIMIT=200

# 資料庫：預設 SQLite（backend/data/twstock.db）
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/twstock

# 收盤後排程（台北時間，平日）
ENABLE_SCHEDULER=true
DAILY_JOB_HOUR=17
DAILY_JOB_MINUTE=40

# 回測成本假設（單邊比例）
FEE_RATE=0.001425
FEE_DISCOUNT=0.6
TAX_STOCK=0.003
TAX_ETF=0.001
SLIPPAGE=0.001

# 品質與排除門檻（初始假設，試跑後校準）
MIN_HISTORY_DAYS=120
STALE_DAYS=5
MIN_TURNOVER_QUANTILE=0.2
